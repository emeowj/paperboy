{
  "title": "Paperboy",
  "description": "Your read-later list, delivered",
  "config": {
    "file": "/.crosspoint/plugin-data/paperboy/config.json"
  },
  "browse": {
    "format": "json",
    "url": "{cfg.server}/list/instapaper?page={page}&limit={limit}",
    "lists_url": "{cfg.server}/lists?token={cfg.token}",
    "headers": {
      "Authorization": "Bearer {cfg.token}"
    },
    "items": "items",
    "fields": {
      "title": "title",
      "author": "subtitle",
      "id": "id",
      "description": "description"
    },
    "page_size": 8
  },
  "download": {
    "url": "{cfg.server}/epub/{id}",
    "headers": {
      "Authorization": "Bearer {cfg.token}"
    },
    "bundle": {
      "base": "base",
      "files": "files",
      "subdir": "Paperboy",
      "remove": "remove"
    }
  },
  "events": {
    "reader.exit": {
      "require_meta": "paperboy_id",
      "connect": true,
      "request": {
        "method": "POST",
        "url": "{cfg.server}/progress",
        "headers": {
          "Authorization": "Bearer {cfg.token}",
          "Content-Type": "application/json"
        },
        "body": "{\"id\":\"{meta.paperboy_id}\",\"percent\":\"{event.percent}\",\"end_percent\":\"{event.end_percent}\",\"event_id\":\"{event.id}\"}"
      }
    },
    "sleep.enter": {
      "require_meta": "paperboy_id",
      "request": {
        "method": "POST",
        "url": "{cfg.server}/progress",
        "headers": {
          "Authorization": "Bearer {cfg.token}",
          "Content-Type": "application/json"
        },
        "body": "{\"id\":\"{meta.paperboy_id}\",\"percent\":\"{event.percent}\",\"end_percent\":\"{event.end_percent}\",\"event_id\":\"{event.id}\"}"
      }
    }
  }
}
